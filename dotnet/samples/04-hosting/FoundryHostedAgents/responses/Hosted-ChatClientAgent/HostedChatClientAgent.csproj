<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Source (ZIP) deploy sample. The code-deploy upload is a flat folder with no
    repo-level props, so the sample carries its own Directory.Packages.props with
    the package versions. Foundry runs `dotnet restore` + `dotnet publish` on this
    project during provisioning (dependencyResolution: remote_build in azure.yaml).
  -->

  <PropertyGroup>
    <!-- Single target: the Foundry dotnet_10 runtime publishes without -f, so the
         project must not multi-target. The empty TargetFrameworks clears the value
         inherited from the repo's samples Directory.Build.props for in-repo builds. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HostedChatClientAgent</RootNamespace>
    <AssemblyName>HostedChatClientAgent</AssemblyName>
    <UserSecretsId>222d2622-da26-4da0-99b4-0507fb8d41b0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" />
    <PackageReference Include="Azure.AI.Projects" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="DotNetEnv" />
  </ItemGroup>

</Project>
