<Project>

  <!--
    This file exists to stop MSBuild from walking up to the repository's
    dotnet/Directory.Packages.props. That file does two things the sample must avoid: it turns on
    central package management, and it injects analyzer PackageReference items whose versions it
    also supplies. Neither travels inside the code-deploy ZIP, so with the repo file in scope the
    in-repo build would resolve differently from the server-side `dotnet restore` on the upload,
    and turning central package management off without stopping the import fails the analyzer
    references with NU1015 (no version specified). The sample pins its own versions in the .csproj.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>