<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworksCore)</TargetFrameworks>
    <RootNamespace>Microsoft.Agents.AI.Foundry.Hosting</RootNamespace>
    <VersionSuffix>preview</VersionSuffix>
    <Title>Microsoft Agent Framework for Foundry Hosted Agents</Title>
    <Description>Provides the protocol-neutral Microsoft Agent Framework services for Foundry Hosted Agents: hosted agent registration, Foundry session and workflow checkpoint storage, and Foundry Toolbox integration. Add a protocol package, such as Microsoft.Agents.AI.Foundry.Hosting.Responses, to serve the agent.</Description>
    <PackageReleaseNotes>Breaking change: the Responses protocol integration (AddFoundryResponses, MapFoundryResponses, FoundryResponsesServerOptions) moved to Microsoft.Agents.AI.Foundry.Hosting.Responses. Reference that package to keep hosting over the Responses protocol; the types keep the Microsoft.Agents.AI.Foundry.Hosting namespace. See docs/decisions/0057-dotnet-foundry-hosting-package-split.md.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <InjectSharedThrow>true</InjectSharedThrow>
    <InjectSharedDiagnosticIds>true</InjectSharedDiagnosticIds>
    <InjectSharedRedaction>true</InjectSharedRedaction>
    <InjectSharedOriginPinning>true</InjectSharedOriginPinning>
    <NoWarn>$(NoWarn);OPENAI001;MEAI001;MAAI001</NoWarn>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <Import Project="$(RepoRoot)/dotnet/nuget/nuget-package.props" />

  <!-- Disable package validation baseline until the first release -->
  <PropertyGroup>
    <PackageValidationBaselineVersion />
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.AgentServer.Core" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Agents.AI.Workflows\Microsoft.Agents.AI.Workflows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Protocol packages run the hosted agent through these internal services (agent source, toolbox
      sessions, consent state). They ship in lockstep with this package.
    -->
    <InternalsVisibleTo Include="Microsoft.Agents.AI.Foundry.Hosting.Responses" />
    <InternalsVisibleTo Include="Microsoft.Agents.AI.Foundry.Hosting.UnitTests" />
    <InternalsVisibleTo Include="Microsoft.Agents.AI.Foundry.Hosting.Responses.UnitTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
